      "label": "Hero's Fortitude",
      "description": "Increases your armor class, attack power and the maximum amount of attack you can gain from items."
    },
    {
      "id": "resolution",
      "label": "Hero's Resolution",
      "description": "Increases your base statistics and the maximum that your base statistics can be increased by items and spells. Additionally, this ability increases your natural hit point, mana and endurance regeneration and the maximum that your hit point and mana regeneration can be increased by items."
    },
    {
      "id": "vitality",
      "label": "Hero's Vitality",
      "description": "Increases your maximum hit points, mana, endurance as well as how far below zero your hit points can fall before you die."
    }
